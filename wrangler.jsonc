{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ljin-blog",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "BLOG_VIEWS"
    }
  ],
  "d1_databases": [
    {
      "binding": "BLOG_DB",
      "database_name": "ljin-blog-content",
      "database_id": "79b19cf0-618e-4b59-868b-074e33f8d05b"
    }
  ],
  "ratelimits": [
    {
      "name": "BLOG_RATE_LIMIT",
      "namespace_id": "4018078",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
